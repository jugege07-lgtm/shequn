# 后端环境配置示例文件
# 复制为 .env 后填写真实值；切勿提交真实密钥到版本库
# 详见 .env 文件中的注释

NODE_ENV=development
PORT=3000

# 数据库（MySQL，与 schema.prisma 一致）
DATABASE_URL="mysql://root:root123456@localhost:3306/community_card"

# JWT（至少 64 字符随机字符串）
JWT_SECRET="use `openssl rand -hex 32` to generate"
JWT_EXPIRES="7d"

# 管理员（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD="set-a-strong-password"

# 手机号加密密钥（至少 32 字符，切勿在有数据后更换）
PHONE_ENCRYPT_KEY="use `openssl rand -hex 16` to generate"

# 腾讯云 SMS（注册/修改支付密码验证码，获取：https://console.cloud.tencent.com/sms）
# 仅需配置以下 5 项即可发送；SMS_APP_KEY 未参与发送流程，可留空
SMS_SDK_APP_ID=""
SMS_SECRET_ID=""
SMS_SECRET_KEY=""
SMS_SIGN_NAME=""
SMS_TEMPLATE_ID=""

# 腾讯云文本内容安全 TMS（发布内容敏感词过滤，获取：https://console.cloud.tencent.com/cms）
# 需在控制台开通「文本内容安全」服务；密钥默认复用上方 SMS_SECRET_ID/KEY（同一腾讯云账号），也可单独指定
# 未配置或接口异常时内容放行（fail-open），服务端日志会输出 [TextModeration] 告警
TMS_SECRET_ID=""
TMS_SECRET_KEY=""

# 微信小程序
WX_APPID="wx8bf6e80cef829949"
WX_SECRET="1b98ce6f41cd3dd517dadfbaaa8a278c"

# 应用域名 / 微信支付回调域名
APP_DOMAIN="jugekeji.cn"

# 微信支付商户证书（APIv3）
WX_CERT_PATH="D:\\DaiMa\\shequn\\backend\\certs\\apiclient_cert.pem"
WX_CERT_KEY_PATH="D:\\DaiMa\\shequn\\backend\\certs\\apiclient_key.pem"
WX_P12_PATH="D:\\DaiMa\\shequn\\backend\\certs\\apiclient_cert.p12"
WX_MCH_ID="1601215643"
WX_API_V3_KEY="8LuMNbNUfcmtkpxloXesFR7Vl1ze3W5p"
WX_PAY_NOTIFY_URL="https://jugekeji.cn/api/pay/wechat/notify"
WX_REFUND_NOTIFY_URL="https://jugekeji.cn/api/pay/wechat/refund-notify"

# Redis（预留）
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# CORS 允许的来源（逗号分隔）
ALLOWED_ORIGINS="http://localhost:5174,http://localhost:5175"

# 文件上传目录
UPLOAD_DIR="uploads"

# 上传文件对外访问基础 URL（生产环境必填，如 https://api.yourdomain.com）
# 不配置时开发环境默认使用 http://localhost:${PORT}
UPLOAD_BASE_URL=""
