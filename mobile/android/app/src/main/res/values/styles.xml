<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@android:color/white</item>
        <!-- edge-to-edge：状态栏/导航栏透明，背景由 WebView 内容（H5 各页面背景）铺满并延伸到系统栏后面。
             不要再强制 statusBarColor 为白色：那会在彩色首屏（登录/注册/首页 banner）顶部盖出白色条。
             状态栏图标明暗由 H5 端 SystemBars.setStyle() 按页面动态切换。 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 强制浅色主题并禁用系统 force-dark：防止 WebView 白底/浅色头被自动暗化，导致状态栏区域出现灰色/暗色条 -->
        <item name="android:forceDarkAllowed">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- 启动后 WebView 沿用此主题：状态栏纯白 + 浅色图标，避免顶部露出灰色区域 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>